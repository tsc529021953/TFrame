diff --git a/apps/xs/app_xs_control/src/main/assets/logback.xml b/apps/xs/app_xs_control/src/main/assets/logback.xml
new file mode 100644
--- /dev/null	(date 1791442224843)
+++ b/apps/xs/app_xs_control/src/main/assets/logback.xml	(date 1791442224843)
@@ -0,0 +1,34 @@
+<!--debug属性用来决定是否打印logback的日志信息-->
+<configuration debug='false'>
+
+    <!--声明一个属性,用来指定log文件存放的路径-->
+    <property name="LOG_DIR" value="/sdcard/Android/data/com.sc.xs_control/cache" />
+
+    <!--声明一个时间戳-->
+    <timestamp datePattern="yyyyMMdd" key="today" />
+
+    <!--用于在控制台输出的Appender-->
+        <appender name="LOGCAT" class="ch.qos.logback.classic.android.LogcatAppender">
+            <encoder>
+                <pattern>%msg%n</pattern>
+            </encoder>
+        </appender>
+
+    <!--声明一个RollingFileAppender-->
+    <appender name="RollLog" class="ch.qos.logback.core.rolling.RollingFileAppender">
+        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
+            <fileNamePattern>${LOG_DIR}/xs_control.%d{yyyy-MM-dd}.log</fileNamePattern>
+            <maxHistory>30</maxHistory>
+        </rollingPolicy>
+        <encoder>
+            <pattern>%d{MM-dd HH:mm:ss.SSS} [%thread] %-5level - %msg%n</pattern>
+        </encoder>
+    </appender>
+
+    <!--     Write TRACE (and higher-level) messages to the log file-->
+    <root level="TRACE">
+        <appender-ref ref="LOGCAT" />
+        <appender-ref ref="RollLog" />
+    </root>
+
+</configuration>
