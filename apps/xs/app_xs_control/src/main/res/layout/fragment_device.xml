                        android:id="@+id/btn_tv1_voice"
                        style="@style/VoiceBtnStyle"
                        android:onClick="@{() -> vm.onTvVoice(1)}"
                        app:mutedIcon="@{vm.tvMuteObs[0].get()}"
                        android:contentDescription="@string/tv_name_1"/>
            </FrameLayout>

            <!-- ========== 块3：换装体验（一体机，只有一行开/关按钮；字符串指令：开="0"、关="1"；无音量按钮） ========== -->
