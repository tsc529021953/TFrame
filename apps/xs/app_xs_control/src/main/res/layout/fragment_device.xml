                                android:drawableLeft="@drawable/ic_pause"
                                android:onClick="@{() -> vm.onTvPause(1)}"
                                android:text="@string/btn_pause"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 右上角：静音/取消静音（"voice:0"/"voice:100"） -->
