<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
                name="vm"
                type="com.sc.xs_control.vm.DeviceViewModel"/>
    </data>

    <!--
      设备控制页：依据效果图绘制
      4列x2行共8个块（白色，圆角24dp，行高234dp，间隔24dp），超出可滚动
      块顺序：PC、电视1、换装体验(一体机)、电视2~6
      普通块三行：图标+名称 / 开+关 / 播放+暂停；换装体验块只有一行按钮
      块根为FrameLayout：除换装体验外，右上角(top=18dp,end=29dp)悬浮44dp音量按钮，
      点击静音/取消静音（图标显示当前状态：已静音=ic_voice_1、未静音=ic_voice_2）
      按钮与指令发射器绑定发送UDP指令（开/关走9128端口，播放/暂停/音量发192.168.1.90~96:2368）
    -->
    <ScrollView
            android:id="@+id/page_device"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:useDefaultMargins="false">

            <!-- ========== 块1：大厅电子屏（字符串指令：开="0"、关="1"） ========== -->
            <FrameLayout style="@style/DeviceBlockFrameStyle">

                <LinearLayout style="@style/DeviceBlockContentStyle">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <ImageView
                                style="@style/BlockIconStyle"
                                android:src="@drawable/ic_tv_room"
                                android:contentDescription="@string/pc"/>

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/pc"
                                android:textColor="@color/text_color"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="PC"/>
                    </LinearLayout>

                    <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                    <!-- 第二行：开 / 关 -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                        <TextView
                                android:id="@+id/btn_pc_on"
                                style="@style/OnBtnStyle"
                                android:onClick="@{() -> vm.onPcOn()}"
                                android:text="@string/btn_on"/>

                        <TextView
                                android:id="@+id/btn_pc_off"
                                style="@style/OffBtnStyle"
                                android:onClick="@{() -> vm.onPcOff()}"
                                android:text="@string/btn_off"/>
                    </LinearLayout>

                    <!-- 第三行：播放 / 暂停（字符串指令"play"/"pause"） -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                        <TextView
                                android:id="@+id/btn_pc_play"
                                style="@style/MediaBtnStyle"
                                android:drawableLeft="@drawable/ic_play"
                                android:onClick="@{() -> vm.onPcPlay()}"
                                android:text="@string/btn_play"/>

                        <TextView
                                android:id="@+id/btn_pc_pause"
                                style="@style/MediaBtnStyle"
                                android:layout_marginStart="10dp"
                                android:drawableLeft="@drawable/ic_pause"
                                android:onClick="@{() -> vm.onPcPause()}"
                                android:text="@string/btn_pause"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 右上角：静音/取消静音（"voice:0"/"voice:100"） -->
                <ImageView
                        android:id="@+id/btn_pc_voice"
                        style="@style/VoiceBtnStyle"
                        android:onClick="@{() -> vm.onPcVoice()}"
                        app:mutedIcon="@{vm.pcMuteObs.get()}"
                        android:contentDescription="@string/pc"/>
            </FrameLayout>

            <!-- ========== 块2：电视1（与一体机调换位置） ========== -->
            <FrameLayout style="@style/DeviceBlockFrameStyle">

                <LinearLayout style="@style/DeviceBlockContentStyle">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <ImageView
