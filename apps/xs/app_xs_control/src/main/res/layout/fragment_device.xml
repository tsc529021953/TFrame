                                style="@style/OnBtnStyle"
                                android:onClick="@{() -> vm.onTvOn(1)}"
                                android:text="@string/btn_on"/>

                        <TextView
                                android:id="@+id/btn_tv1_off"
                                style="@style/OffBtnStyle"
                                android:onClick="@{() -> vm.onTvOff(1)}"
                                android:text="@string/btn_off"/>
                    </LinearLayout>

                    <!-- 第三行：播放 / 暂停（字符串指令"play"/"pause"） -->
