<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        >

    <data>

        <variable
                name="vm"
                type="com.sc.tmp_cw.vm.MainViewModel"/>

        <variable
                name="service"
                type="com.sc.tmp_cw.inter.ITmpService"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/main_title_logo_ly_height"
                android:id="@+id/logo_ly"
                android:layout_marginStart="@dimen/main_title_logo_ly_margin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <ImageView
                    android:layout_width="@dimen/main_title_logo_ly_height"
                    android:layout_height="match_parent"
                    android:id="@+id/logo_iv"
                    app:layout_constraintStart_toStartOf="parent"
                    android:src="@drawable/logo"
                    android:visibility="gone"
                    />

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toEndOf="@+id/logo_iv"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="@mipmap/ic_title_bg"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    >

                <TextView
                        style="@style/main_title_station"
                        android:layout_height="match_parent"
                        android:id="@+id/title_tv"
                        app:layout_constraintStart_toEndOf="@+id/logo_iv"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_weight="1.6"
                        android:layout_margin="5dp"
                        android:text="@{service.titleObs}"
                        android:gravity="start |center_vertical"
                        tools:text="天津地铁8号线欢迎你"
                        />

                <!--                <View style="@style/horizontal_space_style"/>-->

                <!-- CPU 绘制的轻量级跑马灯，不与视频争抢 GPU 资源 -->
<!--                <com.sc.tmp_cw.weight.CpuMarqueeTextView-->
<!--                        style="@style/main_title_station"-->
<!--                        android:layout_weight="2.9"-->
<!--                        android:paddingStart="20dp"-->
<!--                        android:paddingEnd="25dp"-->
<!--                        android:id="@+id/station_tv"-->
<!--                        android:text="@{service.stationObs}"-->
<!--                        android:layerType="software"-->
<!--                        android:clipToOutline="true"-->
<!--                        app:speed="30"-->
<!--                        />-->
                <com.nbhope.lib_frame.widget.MarqueeTextView
                        style="@style/main_title_station"
                        android:layout_weight="2.9"
                        android:paddingStart="20dp"
                        android:paddingEnd="25dp"
                        android:id="@+id/station_tv"
                        android:text="@{service.stationObs}"
                        />
                <!--                android:flipInterval="2500"-->
                <!--                android:inAnimation="@anim/in_right"-->
                <!--                android:outAnimation="@anim/out_left"-->
                <!--                app:marqueeAnimDuration="2000"-->
                <!--                app:smvTextColor="@color/white"-->
                <!--                app:smvTextEllipsize="end"-->
                <!--                app:smvTextGravity="center_vertical"-->
                <!--                app:smvTextSingleLine="true"-->
                <!--                app:smvTextSize="18sp"-->

                <!--                app:startPoint="end"-->
                <!--                app:isRepeat="true"-->
                <!--                app:direction="left"-->
                <!--                app:speed="50"-->
                <!--                app:textcolor="#fff"-->
                <!--                app:textSize="18sp"-->
                <!--                app:marqueebackground="#ff00ff"-->


                <!--                <View style="@style/horizontal_space_style"/>-->

                <TextView
                        style="@style/main_title_station"
                        android:id="@+id/time_tv"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:text="2025年10月12日 99:88:88"
                        android:text="@{service.timeObs}"
                        />

                <!-- flavorB到站后显示的系统时间,非flavorB永不显示,仅为保持绑定类id一致 -->
                <TextClock
                        style="@style/main_title_station"
                        android:layout_weight="0.4"
                        android:id="@+id/time_clock"
                        android:visibility="gone"
                        android:format24Hour="yyyy年MM月dd日 HH:mm"
                        android:format12Hour="yyyy年MM月dd日 HH:mm"
                        tools:text="2026年10月09日 14:30"
                        />

            </LinearLayout>

            <!--            android:background="@drawable/icon_title_station_tv_bg"-->


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

