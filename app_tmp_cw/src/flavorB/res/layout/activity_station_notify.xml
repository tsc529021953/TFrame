<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        >

    <data>

        <variable
                name="service"
                type="com.sc.tmp_cw.inter.ITmpService"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/bg_ly"
            android:background="@android:color/black"
            >

        <!-- id与main布局保持一致(兼容databinding编译),flavorB视频模式下隐藏 -->
        <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:id="@+id/car_iv"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/list_sf"
                android:src="@drawable/ic_station_car2"
                android:scaleType="fitEnd"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                />

        <com.facebook.shimmer.ShimmerFrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:id="@+id/list_sf"
                android:visibility="gone"
                app:shimmer_base_alpha="1"
                app:shimmer_duration="5000"
                app:shimmer_highlight_alpha="0.6"
                app:shimmer_tilt="180"
                app:layout_constraintBottom_toBottomOf="parent"
                >
            <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:id="@+id/floor_iv"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:src="@drawable/ic_station_floor2"
                    android:scaleType="fitXY"
                    />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- 进/出站视频全屏播放(1=station_enter.mp4 0=station_exit.mp4),播完即finish;
             main布局无此控件,代码里用tag查找;fill=拉伸铺满全屏(视频16:9→屏幕16:10,轻微拉伸无黑边) -->
        <com.google.android.exoplayer2.ui.PlayerView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="station_video"
                app:use_controller="false"
                app:resize_mode="fill"
                />

        <!-- 顶部站点信息保留 -->
        <TextView
                style="@style/main_notify_station"
                tools:text="@string/arrive"
                android:text='@{service.stationObs}'
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
